{
    "name": "resume-tweak",
    "private": true,
    "version": "0.0.1",
    "packageManager": "pnpm@10.17.1",
    "scripts": {
        "build:web": "pnpm --filter @resume-tweak/web build",
        "build": "pnpm --filter @resume-tweak/api build",
        "lint": "pnpm --filter @resume-tweak/api lint",
        "test": "pnpm --filter @resume-tweak/api test",
        "test:e2e": "pnpm --filter @resume-tweak/api test:e2e",
        "test:foundry-smoke": "pnpm --filter @resume-tweak/api test:foundry-smoke",
        "start:web": "pnpm --filter @resume-tweak/web dev",
        "start:api": "pnpm --filter @resume-tweak/api start:dev"
    }
}
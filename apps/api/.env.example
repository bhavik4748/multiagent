# Never commit .env. Keep the actual endpoint/key server-side only.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.openai.azure.com
FOUNDRY_API_KEY=<your-foundry-api-key>
FOUNDRY_DEFAULT_MODEL_DEPLOYMENT=gpt-5.6-terra
FOUNDRY_DEFAULT_MODEL_API_VERSION=2025-01-01-preview
# Set to true only after access to the deployment has been granted.
FOUNDRY_SMOKE_TEST_ENABLED=false

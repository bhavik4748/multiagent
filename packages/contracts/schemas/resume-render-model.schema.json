{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://resume-tweak.local/schemas/resume-render-model.schema.json",
    "title": "ResumeRenderModel",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "identity",
        "summary",
        "skills",
        "experience",
        "education",
        "certifications",
        "additionalInformation"
    ],
    "properties": {
        "schemaVersion": {
            "const": "1"
        },
        "identity": {
            "$ref": "#/$defs/identity"
        },
        "summary": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/item"
            }
        },
        "skills": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/item"
            }
        },
        "experience": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/experience"
            }
        },
        "education": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/item"
            }
        },
        "certifications": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/item"
            }
        },
        "additionalInformation": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/item"
            }
        }
    },
    "$defs": {
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sourceFactId",
                "sourceSegmentId"
            ],
            "properties": {
                "sourceFactId": {
                    "type": "string",
                    "minLength": 1
                },
                "sourceSegmentId": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "text",
                "evidence"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "text": {
                    "type": "string",
                    "minLength": 1
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/evidence"
                    }
                }
            }
        },
        "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "contactLines"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/item"
                },
                "headline": {
                    "$ref": "#/$defs/item"
                },
                "contactLines": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/item"
                    }
                }
            }
        },
        "experience": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "achievements"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "heading": {
                    "$ref": "#/$defs/item"
                },
                "achievements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/item"
                    }
                }
            }
        }
    }
}
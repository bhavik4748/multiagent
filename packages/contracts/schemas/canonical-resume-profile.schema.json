{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-tweak.local/schemas/canonical-resume-profile.schema.json",
  "title": "CanonicalResumeProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["resumeId", "claims", "sourceSegments", "status"],
  "properties": {
    "resumeId": { "type": "string", "minLength": 1 },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "sourceSegments": { "type": "array", "items": { "$ref": "#/$defs/sourceSegment" } },
    "status": { "type": "string", "enum": ["draft", "approved"] },
    "approvedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "section", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "section": {
          "type": "string",
          "enum": ["contact", "summary", "skills", "experience", "education", "certifications", "other"]
        },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFactId", "sourceSegmentId"],
      "properties": {
        "sourceFactId": { "type": "string", "minLength": 1 },
        "sourceSegmentId": { "type": "string", "minLength": 1 }
      }
    },
    "sourceSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sequence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

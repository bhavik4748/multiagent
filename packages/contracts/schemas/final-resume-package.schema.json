{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://resume-tweak.local/schemas/final-resume-package.schema.json",
    "title": "FinalResumePackage",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "resumeId",
        "summary",
        "markdown",
        "claims",
        "unresolvedGaps",
        "decisions",
        "changeLog"
    ],
    "properties": {
        "resumeId": {
            "type": "string",
            "minLength": 1
        },
        "summary": {
            "type": "string"
        },
        "markdown": {
            "type": "string",
            "minLength": 1
        },
        "claims": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "text",
                    "section",
                    "evidence"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "text": {
                        "type": "string",
                        "minLength": 1
                    },
                    "section": {
                        "enum": [
                            "contact",
                            "summary",
                            "skills",
                            "experience",
                            "education",
                            "certifications",
                            "other"
                        ]
                    },
                    "evidence": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "sourceFactId",
                                "sourceSegmentId"
                            ],
                            "properties": {
                                "sourceFactId": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "sourceSegmentId": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        }
                    }
                }
            }
        },
        "unresolvedGaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "decisions": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "findingId",
                    "decision",
                    "rationale",
                    "affectedClaimIds"
                ],
                "properties": {
                    "findingId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "decision": {
                        "enum": [
                            "accepted",
                            "rejected",
                            "unresolved"
                        ]
                    },
                    "rationale": {
                        "type": "string",
                        "minLength": 1
                    },
                    "affectedClaimIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "changeLog": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
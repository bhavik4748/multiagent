{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://resume-tweak.local/schemas/tailored-resume-draft.schema.json",
    "title": "TailoredResumeDraft",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "resumeId",
        "claims"
    ],
    "properties": {
        "resumeId": {
            "type": "string",
            "minLength": 1
        },
        "summary": {
            "type": "string"
        },
        "claims": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "text",
                    "evidence"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "text": {
                        "type": "string",
                        "minLength": 1
                    },
                    "evidence": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        }
    }
}
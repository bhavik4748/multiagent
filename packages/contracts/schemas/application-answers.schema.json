{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://resume-tweak.local/schemas/application-answers.schema.json",
    "title": "ApplicationAnswersResponse",
    "type": "object",
    "additionalProperties": false,
    "required": ["resumeId", "modelProfileId", "deployment", "answers"],
    "properties": {
        "resumeId": { "type": "string", "minLength": 1 },
        "modelProfileId": { "type": "string", "minLength": 1 },
        "deployment": { "type": "string", "minLength": 1 },
        "answers": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {
                "type": "object", "additionalProperties": false,
                "required": ["questionId", "status", "answerText", "statements", "missingInformation"],
                "properties": {
                    "questionId": { "type": "string", "minLength": 1 },
                    "status": { "enum": ["answered", "partial", "needs-user-input", "failed"] },
                    "answerText": { "type": "string", "maxLength": 3000 },
                    "error": { "type": "string" },
                    "missingInformation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "statements": {
                        "type": "array", "maxItems": 30,
                        "items": {
                            "type": "object", "additionalProperties": false,
                            "required": ["id", "text", "evidence", "noteReferences"],
                            "properties": {
                                "id": { "type": "string", "minLength": 1 },
                                "text": { "type": "string", "minLength": 1 },
                                "evidence": {
                                    "type": "array",
                                    "items": {
                                        "type": "object", "additionalProperties": false,
                                        "required": ["sourceFactId", "sourceSegmentId", "quote"],
                                        "properties": {
                                            "sourceFactId": { "type": "string", "minLength": 1 },
                                            "sourceSegmentId": { "type": "string", "minLength": 1 },
                                            "quote": { "type": "string", "minLength": 1 }
                                        }
                                    }
                                },
                                "noteReferences": {
                                    "type": "array",
                                    "items": {
                                        "type": "object", "additionalProperties": false,
                                        "required": ["questionId", "quote"],
                                        "properties": {
                                            "questionId": { "type": "string", "minLength": 1 },
                                            "quote": { "type": "string", "minLength": 1 }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
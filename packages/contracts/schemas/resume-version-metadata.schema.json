{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://resume-tweak.local/schemas/resume-version-metadata.schema.json",
    "title": "ResumeVersionMetadata",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "versionId",
        "versionType",
        "sourceResumeId",
        "tailoringRunId",
        "targetRole",
        "createdAt",
        "jobDescriptionHash",
        "modelProfileId",
        "deployment",
        "includedKeywords",
        "unresolvedGaps",
        "artifacts",
        "approvedAt"
    ],
    "properties": {
        "versionId": {
            "type": "string",
            "minLength": 1
        },
        "versionType": {
            "enum": [
                "general",
                "targeted",
                "job-specific"
            ]
        },
        "track": {
            "type": "string"
        },
        "sourceResumeId": {
            "type": "string",
            "minLength": 1
        },
        "tailoringRunId": {
            "type": "string",
            "minLength": 1
        },
        "company": {
            "type": "string"
        },
        "targetRole": {
            "type": "string"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
        "jobDescriptionHash": {
            "type": "string"
        },
        "modelProfileId": {
            "type": "string",
            "minLength": 1
        },
        "deployment": {
            "type": "string",
            "minLength": 1
        },
        "includedKeywords": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "unresolvedGaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "docxPath",
                "pdfPath",
                "contentPath",
                "metadataPath",
                "changeLogPath",
                "reviewReportPath"
            ],
            "properties": {
                "docxPath": {
                    "type": "string",
                    "minLength": 1
                },
                "pdfPath": {
                    "type": "string",
                    "minLength": 1
                },
                "contentPath": {
                    "type": "string",
                    "minLength": 1
                },
                "metadataPath": {
                    "type": "string",
                    "minLength": 1
                },
                "changeLogPath": {
                    "type": "string",
                    "minLength": 1
                },
                "reviewReportPath": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "approvedAt": {
            "type": "string",
            "format": "date-time"
        }
    }
}
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://resume-tweak.local/schemas/review-report.schema.json",
    "title": "ReviewReport",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "reviewer",
        "findings"
    ],
    "properties": {
        "reviewer": {
            "enum": [
                "ats",
                "readability"
            ]
        },
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "reviewer",
                    "severity",
                    "message",
                    "recommendation",
                    "affectedClaimIds"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "reviewer": {
                        "enum": [
                            "ats",
                            "readability"
                        ]
                    },
                    "severity": {
                        "enum": [
                            "high",
                            "medium",
                            "low"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "minLength": 1
                    },
                    "recommendation": {
                        "type": "string",
                        "minLength": 1
                    },
                    "affectedClaimIds": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        }
    }
}